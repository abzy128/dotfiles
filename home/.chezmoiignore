{{ $machine := includeTemplate "machine.json" . | fromJson }}

# Zsh is owned by nix-abzy on all supported Zsh machines.
.zshrc
.zshenv
.zsh
.zsh/**

# AeroSpace helper build output and runtime log stay local.
.config/aerospace/scripts/popout-window
.config/aerospace/scripts/popout-last-run.log

# Karabiner maintains these backups locally.
.config/karabiner/automatic_backups
.config/karabiner/automatic_backups/**

{{ if eq $machine.gitOwner "home-manager" }}
.gitconfig
.gitconfig-work
{{ end }}

{{ if eq .chezmoi.os "windows" }}
.config
.config/**
.local
.local/**
{{ else }}
AppData
AppData/**
Documents
Documents/**
{{ end }}

{{ if ne .chezmoi.os "darwin" }}
Library
Library/**
{{ end }}
{{ if ne .chezmoi.os "linux" }}
.config/lazygit
.config/lazygit/**
{{ end }}

{{ range $name, $feature := .features }}
{{ if or (not (get $machine.features $name)) (not (has $.chezmoi.os $feature.os)) }}
{{ range $feature.paths }}
{{ . }}
{{ . }}/**
{{ end }}
{{ end }}
{{ end }}
